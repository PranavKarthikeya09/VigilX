# vigilX Backend Environment Configuration Template
# Copy this file to .env and configure your local or Supabase credentials.
# NEVER commit the actual .env file or real secrets to version control.

PROJECT_NAME="vigilX"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# Database Configuration (Supabase PostgreSQL Session or Transaction Pooler URI)
# Example Supabase URI: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# (Also accepts raw postgresql:// or postgres:// and automatically normalizes to asyncpg)
# For local offline testing or CI without live Supabase, aiosqlite is used as fallback:
DATABASE_URL="sqlite+aiosqlite:///./vigilx_dev.db"

# Supabase Auth — Asymmetric ECC (P-256 / ES256) JWT Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"

# Allowed JWT algorithms (Strict allowlist, defaults to ES256 for Supabase ECC P-256)
SUPABASE_JWT_ALLOWED_ALGORITHMS="ES256"

# JWKS endpoint (Automatically derived from SUPABASE_URL as:
# https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json)
# You can override it explicitly if using a custom gateway:
# SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Optional static public key in PEM format (if offline or bypassing JWKS network calls):
# SUPABASE_JWT_PUBLIC_KEY=""

# Supabase Service Role Key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Supabase Storage Configuration
SUPABASE_STORAGE_BUCKET="brand-logos"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
