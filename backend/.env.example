# vigilX Backend Environment Configuration Template
# Copy this file to .env and configure your local or Supabase credentials.
# NEVER commit the actual .env file or real secrets to version control.

PROJECT_NAME="vigilX"
ENVIRONMENT="development"
HOST="0.0.0.0"
PORT=8000

# Database Configuration (Supabase PostgreSQL Session or Transaction Pooler URI)
# Example Supabase URI: postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# For local offline testing or CI without live Supabase, aiosqlite can be used as a fallback:
DATABASE_URL="sqlite+aiosqlite:///./vigilx_dev.db"

# Supabase Auth & JWT Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-here"
# Optional JWKS URL if project is configured for RS256/ES256 asymmetric signing:
# SUPABASE_JWKS_URL="https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json"

# Supabase Service Role Key (NEVER expose to frontend)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Supabase Storage Configuration
SUPABASE_STORAGE_BUCKET="brand-logos"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
